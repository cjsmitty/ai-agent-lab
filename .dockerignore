# Keep the build context to requirements.txt + app/ — smaller context,
# fewer cache busts.
.git
.gitignore
.claude/
.venv
venv/
terraform/
k8s/
app/tests/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.ruff_cache/
requirements-dev.txt
Dockerfile
.dockerignore
README.md
CLAUDE.md
*.md
.env
