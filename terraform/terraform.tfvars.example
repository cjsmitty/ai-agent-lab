# Copy to terraform.tfvars and fill in — terraform.tfvars is gitignored, never commit it.

project_id   = "my-gcp-project-id"
region       = "us-central1"
zone         = "us-central1-a"
cluster_name = "ai-agent-lab"

# Cost knobs (defaults shown)
# node_count               = 2      # 1 or 2 spot e2-medium nodes
# enable_artifact_registry = false  # DockerHub is the primary registry for the lab

# Workload Identity naming — must match k8s/ manifests (CLAUDE.md conventions)
# k8s_namespace = "ai-agent"
# ksa_name      = "ai-agent-sa"
# gcp_sa_name   = "ai-agent-app"
