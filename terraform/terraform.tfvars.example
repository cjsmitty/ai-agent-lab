# Copy to terraform.tfvars and fill in — terraform.tfvars is gitignored, never commit it.

project_id   = "my-gcp-project-id"
region       = "us-central1"
zone         = "us-central1-a"
cluster_name = "ai-agent-lab"

# Cost knobs (defaults shown)
# node_count               = 3      # 1-3 spot e2-standard-2 nodes; 3 fits the Harness CI build pod alongside the delegate
# enable_artifact_registry = false  # DockerHub is the primary registry for the lab

# Workload Identity naming — must match k8s/ manifests (CLAUDE.md conventions)
# k8s_namespace  = "ai-agent"                                   # legacy single-namespace binding (backward compat)
# ksa_name       = "ai-agent-sa"                                # same KSA name in every namespace
# gcp_sa_name    = "ai-agent-app"                               # ONE shared GCP SA for all envs (roles/aiplatform.user)
# app_namespaces = ["ai-agent-dev", "ai-agent-uat", "ai-agent-prd"]  # multi-env Harness demo; each gets a WI binding to the shared SA
